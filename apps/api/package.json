{
  "name": "@voice/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "test": "node scripts/check-migrations.mjs migrations && node --test scripts/check-migrations.test.mjs test/landing-script.test.mjs && vp test run",
    "build": "wrangler deploy --dry-run --env nightly --outdir dist",
    "check:migrations": "node scripts/check-migrations.mjs migrations",
    "db:generate": "drizzle-kit generate",
    "check:schema": "node scripts/check-schema.mjs"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.7",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@types/node": "catalog:",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "msw": "2.15.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.147.0"
  }
}
