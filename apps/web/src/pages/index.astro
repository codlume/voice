---
import * as stylex from "@stylexjs/stylex";

import Page from "../layouts/Page.astro";
import { RELEASES_URL, formatSize, loadRelease } from "../release.ts";
import { styles } from "../styles.ts";

const release = await loadRelease();
const description =
  "Hold a shortcut, speak, and let go. Voice transcribes on your Mac and types the text into the app you were using.";
---

<Page title="Voice: dictation for your Mac" description={description} path="/">
  <main {...stylex.attrs(styles.main)}>
    <div>
      <h1 {...stylex.attrs(styles.headline)}>Speak, and it types.</h1>
      <p {...stylex.attrs(styles.lede)}>{description}</p>
    </div>
    <div {...stylex.attrs(styles.download)}>
      <a href={release?.dmgUrl ?? RELEASES_URL} {...stylex.attrs(styles.primary)}>
        Download for Mac
      </a>
      <p {...stylex.attrs(styles.meta)}>
        {
          release
            ? `Version ${release.version} · Apple Silicon · ${formatSize(release.size)}`
            : "For macOS on Apple Silicon"
        }
      </p>
    </div>
  </main>
</Page>
